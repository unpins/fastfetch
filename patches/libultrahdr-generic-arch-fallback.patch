libultrahdr aborts configure on any CPU it has no intrinsics for (POWER
here). Fall back to the generic C path; intrinsics stay off on that target.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -65,7 +65,7 @@
 elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^loongarch64")
   set(ARCH "loong64")
 else()
-  message(FATAL_ERROR "Architecture: ${CMAKE_SYSTEM_PROCESSOR} not recognized")
+  set(ARCH "generic")
 endif()
 
