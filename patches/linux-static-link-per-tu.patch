Link the self-contained optional libraries into the binary instead of
dlopen'ing them from the host: FF_DISABLE_DLOPEN per translation unit,
so only that file's references become direct (fastfetch's library.h
switches on it). Only the host GPU driver/ICD libraries (Vulkan, OpenCL,
EGL, GLX, NVML, MTML) stay dlopen'ed, through the trampoline.

  wayland.c          libwayland-client (crashed when loaded through the
                     trampoline in a Wayland session)
  image.c, im7.c     chafa, zlib, MagickCore (logo)
  lm_linux.c,
  networking_common.c  zlib
  dbus.c             dbus-1
  brightness_linux.c ddcutil
  drm.c, gpu_drm.c   libdrm, libdrm_amdgpu
  xcb.c, xlib.c      xcb-randr, Xrandr
  binary_linux.c     libelf
  settings.c         glib/gio (GSettings, with the embedded dconf backend)
                     and sqlite3
  de_linux.c         libxfce4util: upstream stubs its static path out
                     ("dlopen is disabled"); call xfce_version_string()

--- a/src/common/impl/binary_linux.c
+++ b/src/common/impl/binary_linux.c
@@ -1,3 +1,4 @@
+#define FF_DISABLE_DLOPEN 1
 #include "common/binary.h"
 
 #if defined(FF_HAVE_ELF) || defined(__sun) || (defined(__FreeBSD__) && !defined(__DragonFly__)) || defined(__OpenBSD__) || defined(__NetBSD__)
--- a/src/common/impl/dbus.c
