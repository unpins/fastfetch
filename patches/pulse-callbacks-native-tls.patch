-static void paSinkInfoCallback(FF_A_UNUSED pa_context* c, const pa_sink_info* i, int eol, void* userdata) {
+// libpulse runs these callbacks from pa_mainloop_iterate(), with the
+// host's glibc TLS active; switch back to ours for the body.
+void* dlopen_callback_enter(void);
+void dlopen_callback_exit(void* saved);
+
+static void paSinkInfoCallbackBody(const pa_sink_info* i, int eol, void* userdata) {
     if (eol > 0 || !i) {
         return;
     }
@@ -39,7 +44,13 @@
